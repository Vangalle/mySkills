{
  "name": "project-tracker",
  "version": "0.1.0",
  "description": "Local-first, evidence-based project status system with Git + Pi session fusion",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.5.0 <25"
  },
  "bin": {
    "project-tracker": "dist/cli.js"
  },
  "main": "dist/contracts.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:web": "vite build --config web/vite.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "start": "node dist/cli.js dashboard"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "diff": "^7.0.0",
    "execa": "^9.5.2",
    "fastify": "^5.2.1",
    "marked": "17.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "smol-toml": "1.8.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@testing-library/react": "^16.1.0",
    "@types/diff": "^7.0.0",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^3.0.0"
  }
}
